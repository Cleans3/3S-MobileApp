+    private val prefs = context.applicationContext
+        .getSharedPreferences("session", Context.MODE_PRIVATE)
+
+    init {
+        // Preserve existing sessions while removing the legacy plaintext value.
+        prefs.getString(LEGACY_TOKEN_KEY, null)?.let { legacyToken ->
+            prefs.edit()
+                .putString(TOKEN_KEY, encrypt(legacyToken))
+                .remove(LEGACY_TOKEN_KEY)
