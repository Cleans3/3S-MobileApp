+            EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM,
+        )
+    }
+
+    init {
+        // Migrate a token written by older builds into encrypted storage, then drop the plaintext copy.
+        val legacy = context.getSharedPreferences("session", Context.MODE_PRIVATE)
+        val legacyToken = legacy.getString("token", null)
+        if (legacyToken != null) {
+            if (prefs.getString("token", null) == null) {
+                prefs.edit().putString("token", legacyToken).apply()
+            }
+            legacy.edit().remove("token").apply()
+        }
+    }
 
     fun save(token: String) {
