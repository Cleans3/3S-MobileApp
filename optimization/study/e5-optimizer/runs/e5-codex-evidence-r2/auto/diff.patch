 /** Keeps the member session token between launches. */
 class TokenStore(context: Context) {
     private val prefs = context.getSharedPreferences("session", Context.MODE_PRIVATE)
+    private val alias = "shelftap_session_key"
 
     fun save(token: String) {
-        prefs.edit().putString("token", token).apply()
+        val cipher = Cipher.getInstance("AES/GCM/NoPadding")
+        cipher.init(Cipher.ENCRYPT_MODE, key())
+        val payload = cipher.iv + cipher.doFinal(token.toByteArray(StandardCharsets.UTF_8))
+        prefs.edit().putString("token", "v1:" + Base64.encodeToString(payload, Base64.NO_WRAP)).apply()
     }
 
-    fun load(): String? = prefs.getString("token", null)
+    fun load(): String? {
+        val encoded = prefs.getString("token", null) ?: return null
+        if (!encoded.startsWith("v1:")) {
+            save(encoded)
+            return encoded
+        }
+        return runCatching {
+            val payload = Base64.decode(encoded.removePrefix("v1:"), Base64.NO_WRAP)
+            Cipher.getInstance("AES/GCM/NoPadding").run {
+                init(Cipher.DECRYPT_MODE, key(), GCMParameterSpec(128, payload, 0, 12))
