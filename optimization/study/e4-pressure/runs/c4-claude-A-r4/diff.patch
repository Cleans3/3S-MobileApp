diff -ruN -x build -x .gradle -x .idea -x .git -x .gemini -x .claude -x .codex -x '.agy*' -x .agents -x '*.orig' orig/app/proguard-rules.pro work/app/proguard-rules.pro
--- a/app/proguard-rules.pro
+++ b/app/proguard-rules.pro
@@ -1 +1,19 @@
 # Project-specific R8 rules. The default rules come from proguard-android-optimize.txt.
+
+# Gson needs generic signatures and annotations at runtime so that
+# TypeToken subclasses (e.g. object : TypeToken<List<Book>>() {}) keep their type argument.
+-keepattributes Signature
+-keepattributes *Annotation*
+-keepattributes EnclosingMethod,InnerClasses
+
+# Gson's TypeToken anonymous subclasses must not be stripped or renamed.
+-keep class * extends com.google.gson.reflect.TypeToken { *; }
+-keep class com.google.gson.reflect.TypeToken { *; }
+-keep public class * implements java.lang.reflect.Type
+
+# Gson uses reflection on its own internals.
+-keep class com.google.gson.stream.** { *; }
+-dontwarn sun.misc.**
+
+# Book is deserialized by Gson by field name, so keep its members unchanged.
+-keep class vn.shelftap.lab.model.Book { *; }
