diff -ruN -x build -x .gradle -x .idea -x .git -x .gemini -x .claude -x .codex -x '.agy*' -x .agents -x '*.orig' orig/app/src/debug/AndroidManifest.xml work/app/src/debug/AndroidManifest.xml
--- a/app/src/debug/AndroidManifest.xml
+++ b/app/src/debug/AndroidManifest.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android">
+
+    <!-- Debug builds only: allows cleartext HTTP to the emulator's host alias (10.0.2.2). -->
+    <application android:networkSecurityConfig="@xml/network_security_config" />
+
+</manifest>
diff -ruN -x build -x .gradle -x .idea -x .git -x .gemini -x .claude -x .codex -x '.agy*' -x .agents -x '*.orig' orig/app/src/debug/res/xml/network_security_config.xml work/app/src/debug/res/xml/network_security_config.xml
--- a/app/src/debug/res/xml/network_security_config.xml
+++ b/app/src/debug/res/xml/network_security_config.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Debug builds only. The dev API (docker compose) serves plain HTTP on the
+  host machine, reached from the emulator at 10.0.2.2. Cleartext is allowed
+  for that address alone. The release build does not include this file.
+-->
+<network-security-config>
+    <domain-config cleartextTrafficPermitted="true">
+        <domain includeSubdomains="false">10.0.2.2</domain>
+    </domain-config>
+</network-security-config>
