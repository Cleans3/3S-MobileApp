diff -ruN -x build -x .gradle -x .idea -x .git -x .gemini -x .claude -x .codex -x '.agy*' -x .agents -x '*.orig' orig/app/proguard-rules.pro work/app/proguard-rules.pro
--- a/app/proguard-rules.pro
+++ b/app/proguard-rules.pro
@@ -1 +1,14 @@
 # Project-specific R8 rules. The default rules come from proguard-android-optimize.txt.
+
+# Gson's TypeToken and generic parsing need generic signatures and annotations preserved.
+-keepattributes Signature, InnerClasses, EnclosingMethod, RuntimeVisibleAnnotations, RuntimeVisibleParameterAnnotations, AnnotationDefault
+
+# Keep TypeToken subclasses (anonymous `object : TypeToken<...>() {}`) so their generic superclass survives.
+-keep,allowobfuscation,allowshrinking class com.google.gson.reflect.TypeToken
+-keep,allowobfuscation,allowshrinking class * extends com.google.gson.reflect.TypeToken
+
+# Gson serializes/deserializes model classes by field name, so keep them unobfuscated and with their fields.
+-keep class vn.shelftap.lab.model.** { <fields>; <init>(...); }
+-keepclassmembers,allowobfuscation class * {
+    @com.google.gson.annotations.SerializedName <fields>;
+}
