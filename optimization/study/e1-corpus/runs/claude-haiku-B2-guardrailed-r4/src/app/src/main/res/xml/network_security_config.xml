<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. Cleartext stays disabled; no user or debug CA overrides are declared. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
