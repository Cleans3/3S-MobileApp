<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. Cleartext is disabled explicitly so API 26-27 (where the default allows it) are covered too. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
