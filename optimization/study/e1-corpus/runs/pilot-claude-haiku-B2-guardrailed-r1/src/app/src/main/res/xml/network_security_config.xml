<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, for every host. No debug-overrides: the API uses a publicly trusted certificate. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
