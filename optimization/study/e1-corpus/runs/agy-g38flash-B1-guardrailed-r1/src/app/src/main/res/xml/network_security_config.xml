<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Rule 1: Use HTTPS for every request. Never set cleartextTrafficPermitted="true" -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
