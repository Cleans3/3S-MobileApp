<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, system trust store only. No debug-overrides: the API is reached over HTTPS everywhere. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
