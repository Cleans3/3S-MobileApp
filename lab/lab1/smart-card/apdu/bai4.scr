// Bai 4 - store "id|name|date of birth|hometown", then read it back
powerup;
// CREATE APPLET 4B4D414C31 04 01 (simulator install, as in cref scripts) -> AID + 90 00
0x80 0xB8 0x00 0x00 0x09 0x07 0x4B 0x4D 0x41 0x4C 0x31 0x04 0x01 0x00 0x7F;
// SELECT applet 4B4D414C31 04 01
0x00 0xA4 0x04 0x00 0x07 0x4B 0x4D 0x41 0x4C 0x31 0x04 0x01 0x7F;
// read before storing -> 69 85
0x80 0x03 0x00 0x00 0x00 0x7F;
// STORE "AT190101|Nguyen Van A|01/01/2004|Ha Noi" (39 bytes) -> 90 00
0x80 0x01 0x00 0x00 0x27 0x41 0x54 0x31 0x39 0x30 0x31 0x30 0x31 0x7C 0x4E 0x67 0x75 0x79 0x65 0x6E 0x20 0x56 0x61 0x6E 0x20 0x41 0x7C 0x30 0x31 0x2F 0x30 0x31 0x2F 0x32 0x30 0x30 0x34 0x7C 0x48 0x61 0x20 0x4E 0x6F 0x69 0x7F;
// field 1, student ID -> "AT190101"
0x80 0x02 0x01 0x00 0x00 0x7F;
// field 2, full name -> "Nguyen Van A"
0x80 0x02 0x02 0x00 0x00 0x7F;
// field 3, date of birth -> "01/01/2004"
0x80 0x02 0x03 0x00 0x00 0x7F;
// field 4, hometown -> "Ha Noi"
0x80 0x02 0x04 0x00 0x00 0x7F;
// whole string -> "AT190101|Nguyen Van A|01/01/2004|Ha Noi"
0x80 0x03 0x00 0x00 0x00 0x7F;
// bad field number -> 6A 86
0x80 0x02 0x05 0x00 0x00 0x7F;
// STORE without separators ("abc") -> 6A 80
0x80 0x01 0x00 0x00 0x03 0x61 0x62 0x63 0x7F;
powerdown;
