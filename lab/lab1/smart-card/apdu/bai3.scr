// Bai 3 - area, 2-byte unsigned big-endian result
powerup;
// CREATE APPLET 4B4D414C31 03 01 (simulator install, as in cref scripts) -> AID + 90 00
0x80 0xB8 0x00 0x00 0x09 0x07 0x4B 0x4D 0x41 0x4C 0x31 0x03 0x01 0x00 0x7F;
// SELECT applet 4B4D414C31 03 01
0x00 0xA4 0x04 0x00 0x07 0x4B 0x4D 0x41 0x4C 0x31 0x03 0x01 0x7F;
// square, side 5 -> 00 19 (25)
0x80 0x01 0x00 0x00 0x01 0x05 0x02;
// rectangle, 4 x 7 -> 00 1C (28)
0x80 0x02 0x00 0x00 0x02 0x04 0x07 0x02;
// square, side 255 -> FE 01 (65025, the largest area)
0x80 0x01 0x00 0x00 0x01 0xFF 0x02;
// rectangle with one side missing -> 67 00 (wrong length)
0x80 0x02 0x00 0x00 0x01 0x04 0x02;
powerdown;
