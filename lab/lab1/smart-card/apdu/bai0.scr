// Bai 0 - pocket calculator from the lab guide (CLA A0, operands in P1 and P2)
powerup;
// CREATE APPLET 11223344550000 (simulator install, as in cref scripts) -> AID + 90 00
0x80 0xB8 0x00 0x00 0x09 0x07 0x11 0x22 0x33 0x44 0x55 0x00 0x00 0x00 0x7F;
// SELECT applet 11223344550000 (guide: /select 11223344550000) -> 90 00
0x00 0xA4 0x04 0x00 0x07 0x11 0x22 0x33 0x44 0x55 0x00 0x00 0x7F;
// add 2 + 3 (guide: /send a0000203) -> 00 05
0xA0 0x00 0x02 0x03 0x00 0x02;
// subtract 5 - 2 (guide: /send a0010502) -> 00 03
0xA0 0x01 0x05 0x02 0x00 0x02;
// multiply 2 * 3 (guide: /send a0020203) -> 00 06
0xA0 0x02 0x02 0x03 0x00 0x02;
// divide 9 / 3 (guide: /send a0030903) -> 00 03
0xA0 0x03 0x09 0x03 0x00 0x02;
// subtract 2 - 5, negative result -> FF FD (-3)
0xA0 0x01 0x02 0x05 0x00 0x02;
// divide by zero 9 / 0 -> 6B 00
0xA0 0x03 0x09 0x00 0x00 0x02;
// wrong class byte (80 instead of A0) -> 6E 00
0x80 0x00 0x02 0x03 0x00 0x02;
// unknown instruction 04 -> 6D 00
0xA0 0x04 0x02 0x03 0x00 0x02;
powerdown;
