# Copy to server/.env (gitignored) and fill every value in. Never commit the real file.
# Generate each key and password with:  openssl rand -base64 32

# PostgreSQL (compose.yaml and the server both read these)
SHELFTAP_DB_PASSWORD=

# Secrets the server refuses to start without: Base64, at least 32 bytes each
SHELFTAP_JWT_KEY=
SHELFTAP_MASTER_KEY=
SHELFTAP_GATE_KEY=

# Password of the TLS keystore made by scripts/dev-tls.sh
SHELFTAP_TLS_KEYSTORE_PASSWORD=

# Profile `dev` only: passwords of the demo librarian ("librarian") and demo member ("member@shelftap.test")
SHELFTAP_DEV_LIBRARIAN_PASSWORD=
SHELFTAP_DEV_MEMBER_PASSWORD=

# Optional overrides
# SHELFTAP_DB_URL=jdbc:postgresql://localhost:5432/shelftap
# SHELFTAP_DB_USER=shelftap
# SHELFTAP_DB_PORT=5432
# SHELFTAP_TLS_KEYSTORE=dev-tls/shelftap-dev.p12
